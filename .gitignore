# Portable release output (tools/make_portable.sh): the dist folder + zip are
# build artifacts — the source of truth is the source tree, releases carry the
# zip as a GitHub release asset, never in git.
dist/

# ---- local-only: ONLY the code goes to GitHub; everything else stays on the
# dev machine (run logs, backups, agent notes, editor config, working docs).
